# CloudPilot settings — copy to .env and adjust.
#
# Every key uses the CLOUDPILOT_ environment-variable prefix. The values
# below are safe placeholders. Real AWS credentials are NEVER set here and
# never belong in this file: they are read from the ambient AWS environment
# (shared credentials file, environment, or instance role) — see
# src/cloudpilot/core/aws.py.

# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
CLOUDPILOT_LOG_LEVEL=INFO

# Emit JSON logs (true) or human-readable text (false)
CLOUDPILOT_LOG_JSON=true

# AWS region for all clients
CLOUDPILOT_AWS_REGION=us-east-1

# Optional: named profile from ~/.aws/credentials (ambient credentials are
# used when unset)
#CLOUDPILOT_AWS_PROFILE=

# Optional: IAM role ARN to assume via STS; unset means use ambient
# credentials directly. Placeholder account id — replace with a real ARN.
#CLOUDPILOT_AWS_ROLE_ARN=arn:aws:iam::123456789012:role/cloudpilot-dev

# Optional: external id for the role trust policy. Operator-supplied and
# semi-secret — the value here is an obvious placeholder, never a real one.
#CLOUDPILOT_AWS_STS_EXTERNAL_ID=placeholder-external-id

# Optional: STS session duration in seconds (900-3600)
#CLOUDPILOT_AWS_STS_DURATION_SECONDS=3600
